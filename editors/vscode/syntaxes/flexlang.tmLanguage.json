{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FlexLang",
  "scopeName": "source.flex",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.flex",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "storage.type.class.jsdoc",
              "match": "@(param|return|returns|throws|type|template|summary|deprecated)\\b"
            }
          ]
        },
        {
          "name": "comment.line.triple-slash.documentation.flex",
          "match": "///.*$"
        },
        {
          "name": "comment.block.flex",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.flex",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flex",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[nrt\\\\\"'0])"
            },
            {
              "name": "meta.interpolation.flex",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.flex"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.flex"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "meta.interpolation.compact.flex",
              "begin": "\\{(?=[a-zA-Z_][\\w\\.]*\\})",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.flex"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.flex"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.flex",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.variant.builtin.flex",
          "match": "\\b(Ok|Err|Some|None)\\b"
        },
        {
          "name": "constant.numeric.float.flex",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.flex",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.variable.flex",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "storage.modifier.mut.flex",
          "match": "\\b(mut)\\b"
        },
        {
          "name": "keyword.control.concurrency.flex",
          "match": "\\b(scope|spawn)\\b"
        },
        {
          "name": "keyword.control.flow.flex",
          "match": "\\b(if|else|match|for|in|while|return)\\b"
        },
        {
          "name": "keyword.control.import.flex",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "keyword.declaration.type.flex",
          "match": "\\b(struct|impl|trait|enum|func)\\b"
        },
        {
          "name": "variable.language.self.flex",
          "match": "\\b(self)\\b"
        },
        {
          "name": "support.function.builtin.flex",
          "match": "\\b(print)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.flex",
          "match": "\\b(Int|Float|String|Bool|Void|Any|Map)\\b"
        },
        {
          "name": "support.type.builtin.flex",
          "match": "\\b(Result|Option|Channel)\\b"
        },
        {
          "name": "support.class.stdlib.flex",
          "match": "\\b(Server|ServerConfig|CorsConfig|Request|Response|PathParams|Pool|PoolConfig|Client|QueryResult|Transaction|Decimal)\\b"
        },
        {
          "name": "entity.name.type.flex",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.flex",
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.flex"
            },
            "2": {
              "name": "entity.name.function.flex"
            }
          }
        },
        {
          "name": "meta.struct.declaration.flex",
          "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.flex"
            },
            "2": {
              "name": "entity.name.type.struct.flex"
            }
          }
        },
        {
          "name": "meta.enum.declaration.flex",
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.flex"
            },
            "2": {
              "name": "entity.name.type.enum.flex"
            }
          }
        },
        {
          "name": "meta.trait.declaration.flex",
          "match": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.flex"
            },
            "2": {
              "name": "entity.name.type.trait.flex"
            }
          }
        },
        {
          "name": "meta.impl.declaration.flex",
          "match": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)(?:\\s+(for)\\s+([A-Z][a-zA-Z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.flex"
            },
            "2": {
              "name": "entity.name.type.flex"
            },
            "3": {
              "name": "keyword.control.flow.flex"
            },
            "4": {
              "name": "entity.name.type.struct.flex"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.method-call.flex",
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.member.flex"
            }
          }
        },
        {
          "name": "meta.function-call.flex",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.flex"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.control.arrow.flex",
          "match": "->"
        },
        {
          "name": "keyword.operator.control.fat-arrow.flex",
          "match": "=>"
        },
        {
          "name": "keyword.operator.unwrap.try.flex",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.range.flex",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.flex",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.flex",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.flex",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.flex",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.pipe.flex",
          "match": "\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.delimiter.comma.flex",
          "match": ","
        },
        {
          "name": "punctuation.delimiter.semicolon.flex",
          "match": ";"
        },
        {
          "name": "punctuation.delimiter.colon.flex",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.flex",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.curly.flex",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.round.flex",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.flex",
          "match": "[\\[\\]]"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.flex",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
