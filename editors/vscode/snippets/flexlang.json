{
  "Function Declaration": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:Void} {",
      "\t$0",
      "}"
    ],
    "description": "Declara uma nova função em FlexLang"
  },
  "Main Function": {
    "prefix": "main",
    "body": [
      "func main() {",
      "\t$0",
      "}",
      "",
      "main();"
    ],
    "description": "Ponto de entrada padrão (main) para execução"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:String},",
      "\t$0",
      "}"
    ],
    "description": "Declara uma nova struct de dados"
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:StructName} {",
      "\tfunc ${2:method_name}(mut self${3:, param: Type}) -> ${4:Void} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implementa métodos para uma struct"
  },
  "Impl Trait Block": {
    "prefix": "impl-trait",
    "body": [
      "impl ${1:TraitName} for ${2:StructName} {",
      "\tfunc ${3:method_name}(self${4:, param: Type}) -> ${5:Void} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implementa um Trait para uma struct"
  },
  "Trait Declaration": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tfunc ${2:method_name}(self${3:, param: Type}) -> ${4:Void};",
      "}"
    ],
    "description": "Declara um novo Trait"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:VariantA}(${3:String}),",
      "\t${4:VariantB},",
      "\t$0",
      "}"
    ],
    "description": "Declara um Enum com variantes"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:expression} {",
      "\t${2:Variant}(${3:val}) => {",
      "\t\t$0",
      "\t},",
      "}"
    ],
    "description": "Desestruturação exaustiva de padrão (Pattern Matching)"
  },
  "Match Result": {
    "prefix": "match-result",
    "body": [
      "match ${1:result} {",
      "\tResult.Ok(${2:data}) => {",
      "\t\t${3:print(\"Sucesso: \", data);}",
      "\t},",
      "\tResult.Err(${4:err}) => {",
      "\t\t${5:print(\"Erro: \", err);}",
      "\t}",
      "}"
    ],
    "description": "Pattern matching sobre Result<T, E>"
  },
  "Match Option": {
    "prefix": "match-option",
    "body": [
      "match ${1:option} {",
      "\tOption.Some(${2:val}) => {",
      "\t\t$0",
      "\t},",
      "\tOption.None => {",
      "\t\t",
      "\t}",
      "}"
    ],
    "description": "Pattern matching sobre Option<T>"
  },
  "Structured Concurrency Scope": {
    "prefix": "scope",
    "body": [
      "scope {",
      "\tspawn {",
      "\t\t$0",
      "\t};",
      "}"
    ],
    "description": "Bloco de concorrência estruturada com tarefas gerenciadas"
  },
  "Spawn Task": {
    "prefix": "spawn",
    "body": [
      "spawn {",
      "\t$0",
      "};"
    ],
    "description": "Gera uma nova green thread dentro de um scope"
  },
  "Channel Creation": {
    "prefix": "channel",
    "body": [
      "let ${1:ch} = Channel.new();",
      "$0"
    ],
    "description": "Cria um novo canal tipado e seguro para concorrência"
  },
  "HTTP Server Setup": {
    "prefix": "http-server",
    "body": [
      "import { Server, ServerConfig, CorsConfig } from \"net/http\";",
      "import { log } from \"core/log\";",
      "",
      "let mut server = Server.new(\":${1:3000}\", ServerConfig {",
      "\tread_timeout: 5000,",
      "\tmax_body_size: 1000000",
      "});",
      "",
      "server.get(\"/healthz\", |req, res| {",
      "\tres.json(200, { status: \"ok\" });",
      "});",
      "",
      "log.info(\"Servidor FlexLang rodando na porta :${1:3000}\");",
      "server.start();"
    ],
    "description": "Inicializa um servidor REST HTTP completo com net/http"
  },
  "HTTP Route Handler": {
    "prefix": "http-route",
    "body": [
      "server.${1|get,post,put,patch,delete|}(\"${2:/path}\", |req, res| {",
      "\t$0",
      "\tres.json(200, { success: true });",
      "});"
    ],
    "description": "Registra uma rota HTTP em um servidor"
  },
  "PostgreSQL Pool": {
    "prefix": "db-pool",
    "body": [
      "import { Pool, PoolConfig } from \"db/postgres\";",
      "",
      "let db = Pool.new(PoolConfig {",
      "\tconnection_string: \"${1:postgres://user:pass@localhost:5432/mydb}\",",
      "\tmax_open_conns: ${2:10},",
      "\tmax_idle_conns: ${3:5}",
      "});",
      "$0"
    ],
    "description": "Configura um pool gerenciado de conexões PostgreSQL"
  },
  "PostgreSQL Query": {
    "prefix": "db-query",
    "body": [
      "let ${1:result} = db.query(\"${2:SELECT id, name FROM users WHERE id = $1}\", [${3:user_id}])?;"
    ],
    "description": "Executa uma query parametrizada segura no PostgreSQL com propagação via '?'"
  },
  "Structured Log Info": {
    "prefix": "log-info",
    "body": [
      "log.info(\"${1:Mensagem}\", {",
      "\t${2:key}: \"${3:value}\"",
      "});"
    ],
    "description": "Emite um log estruturado com contexto JSON"
  },
  "Import Statement": {
    "prefix": "import",
    "body": [
      "import { ${1:Symbol} } from \"${2:./module}\";"
    ],
    "description": "Importa símbolos de módulos locais ou nativos"
  },
  "Unit Test Template": {
    "prefix": "test",
    "body": [
      "func test_${1:feature}() {",
      "\tlet result = ${2:call()};",
      "\tprint(\"Test ${1:feature}: \", result);",
      "}",
      "",
      "test_${1:feature}();"
    ],
    "description": "Template de função de teste unitário"
  },
  "For In Collection": {
    "prefix": "for-in",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t$0",
      "}"
    ],
    "description": "Itera sobre uma coleção (Array, Map ou Range)"
  },
  "For In Collection with Index": {
    "prefix": "for-index",
    "body": [
      "for ${1:item}, ${2:index} in ${3:collection} {",
      "\t$0",
      "}"
    ],
    "description": "Itera sobre uma coleção com acesso ao índice/chave"
  }
}
